{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAME quote-free normalized evidence card row",
  "description": "Complete field contract for one CSV row. Numeric and Boolean fields permit their CSV string serialization.",
  "type": "object",
  "required": [
    "card_id",
    "ticker",
    "observed_quarter",
    "target_quarter",
    "instance_id",
    "signature_key",
    "native_source",
    "driver_source",
    "segment",
    "relation",
    "relation_family",
    "category",
    "canonical_factor",
    "polarity",
    "strength",
    "confidence",
    "persistence_hint",
    "support_type",
    "source_sentence_ids_json",
    "attribution_method",
    "attribution_anchor",
    "affected_quarter",
    "temporal_type",
    "segment_share_at_observed",
    "segment_rank_at_observed",
    "is_forward_target_quarter",
    "is_observed_realized",
    "novelty_state",
    "panel_type",
    "archetype",
    "source_text_sha256",
    "source_text_char_count",
    "public_release_status",
    "derived_artifact_status",
    "source_material_access_status",
    "source_material_redistribution_status",
    "verbatim_text_status"
  ],
  "properties": {
    "card_id": {"type": "string", "pattern": "^[0-9a-f]{20}$", "description": "Release-local stable card identifier."},
    "ticker": {"type": "string", "enum": ["AAPL", "NVDA", "AVGO", "AMZN", "ASML", "GOOGL", "INTC", "META", "MSFT", "MU", "TSLA", "ORCL"], "description": "Center-company ticker."},
    "observed_quarter": {"type": "string", "pattern": "^FY[0-9]{4}_Q[1-4]$", "description": "Fiscal quarter observed at the forecast origin."},
    "target_quarter": {"type": "string", "pattern": "^FY[0-9]{4}_Q[1-4]$", "description": "Fiscal quarter whose revenue is forecast."},
    "instance_id": {"type": "string", "pattern": "^[0-9a-f]{24}$", "description": "Opaque equality-preserving source-instance identifier."},
    "signature_key": {"type": "string", "pattern": "^[0-9a-f]{24}$", "description": "Opaque equality-preserving normalized-card signature."},
    "native_source": {"type": "string", "enum": ["ledger_forward", "ledger_forward+shock_forward"], "description": "Compatibility label for the contributing forward extraction stream or streams."},
    "driver_source": {"type": "string", "enum": ["claim", "event"], "description": "Relation/claim or strict target-quarter event origin."},
    "segment": {"type": "string", "description": "Normalized center-company segment or unresolved target label."},
    "relation": {"type": "string", "description": "Normalized typed relation attached to the driver."},
    "relation_family": {"type": "string", "enum": ["competition", "demand", "geopolitics", "inventory", "macro", "other", "pricing", "product_transition", "regulation", "revenue_boost", "revenue_limit", "supply"], "description": "Coarse relation family."},
    "category": {"type": "string", "enum": ["competition", "demand", "geopolitics", "inventory", "macro", "other", "pricing", "product_transition", "regulation", "supply"], "description": "Normalized driver category."},
    "canonical_factor": {"type": "string", "enum": ["demand", "inventory_channel", "other", "pricing_margin", "product_transition", "regulation_macro", "revenue_boost_limit", "supply_capacity"], "description": "Shared company-independent factor category used by CAME."},
    "polarity": {"type": "string", "enum": ["positive", "negative", "mixed", "unknown"], "description": "Normalized expected revenue direction."},
    "strength": {"type": "string", "enum": ["low", "medium", "high", "unknown"], "description": "Normalized qualitative impact strength."},
    "confidence": {"type": ["number", "string"], "description": "Extraction confidence on the zero-to-one scale."},
    "persistence_hint": {"type": ["boolean", "string"], "description": "Whether the extracted structure explicitly indicates persistence."},
    "support_type": {"type": "string", "enum": ["", "explicit", "inferred"], "description": "Whether target attribution is explicit, structurally inferred, or unavailable."},
    "source_sentence_ids_json": {"type": "string", "description": "JSON array of source-local sentence locators; source text is not included."},
    "attribution_method": {"type": "string", "enum": ["explicit_segment", "explicit_segment_with_path", "explicit_tail", "unresolved"], "description": "Structured target-attribution rule."},
    "attribution_anchor": {"type": "string", "pattern": "^$|^[0-9a-f]{24}$", "description": "Opaque equality-preserving attribution anchor; blank when attribution is unresolved."},
    "affected_quarter": {"type": "string", "pattern": "^FY[0-9]{4}_Q[1-4]$", "description": "Quarter assigned as affected by the normalized evidence."},
    "temporal_type": {"type": "string", "enum": ["Forecast/Guidance", "Condition/External", "Realized/Reporting"], "description": "Extraction-time temporal evidence category."},
    "segment_share_at_observed": {"type": ["number", "string"], "description": "Available segment revenue share at the observed quarter; blank when unavailable."},
    "segment_rank_at_observed": {"type": ["integer", "string"], "description": "Available segment revenue rank at the observed quarter; zero denotes unavailable."},
    "is_forward_target_quarter": {"type": ["boolean", "string"], "description": "Forward-target-quarter classification flag."},
    "is_observed_realized": {"type": ["boolean", "string"], "description": "Observed-quarter realized classification flag."},
    "novelty_state": {"type": "string", "enum": ["persistent", "unknown"], "description": "Available temporal novelty/persistence state."},
    "panel_type": {"type": "string", "enum": ["full_mainpanel", "reduced_window"], "description": "Compatibility label for the card-construction coverage window, not an evaluation split."},
    "archetype": {"type": "string", "enum": ["auto_retail", "cloud_platform_ads", "consumer_device_ecosystem", "enterprise_software_cloud", "semi_infra_tooling"], "description": "Shared company-configuration category."},
    "source_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Unsalted hash locator for withheld supporting text; not anonymization or a rights grant."},
    "source_text_char_count": {"type": ["integer", "string"], "description": "Character count of the withheld supporting text."},
    "public_release_status": {"const": "included_in_public_release", "description": "Public-inclusion provenance dimension."},
    "derived_artifact_status": {"const": "author_created_derived_post_extraction_card", "description": "Derived-artifact provenance dimension."},
    "source_material_access_status": {"const": "not_included_mixed_public_or_provider_access", "description": "Source-access provenance dimension."},
    "source_material_redistribution_status": {"const": "not_redistributed_no_rights_grant", "description": "Source-redistribution provenance dimension."},
    "verbatim_text_status": {"const": "withheld_hash_locator_only", "description": "Verbatim-text provenance dimension."}
  },
  "additionalProperties": false
}
